# Environment Configuration Template
# Copy to .env if you wish to override defaults (never commit real secrets)

# Workspace Paths (defaults to local repository directory)
# DATA_DIR=./data
# MODELS_DIR=./models
# TOKENIZER_PATH=./data/tokenizer.pkl
# REWRITER_MODEL_DIR=./models/t5_neutralizer

# Inference Settings
# Default classifier: bigru (recommended), gru, bilstm, or lstm
DEFAULT_CLASSIFIER=bigru

# Decision threshold for toxicity classification (default 0.40)
DETECTION_THRESHOLD=0.40

# Sequence length constraints
CLASSIFIER_MAX_LEN=200
REWRITER_MAX_INPUT_LEN=64
REWRITER_MAX_OUTPUT_LEN=64

# Force Torch Device: cpu, cuda, or mps (leave blank for automatic selection)
# TORCH_DEVICE=cpu

